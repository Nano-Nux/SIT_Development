# ==========================================
# Database Configuration
# ==========================================
# Aiven / PostgreSQL connection URL
DATABASE_URL=postgres://username:password@hostname:port/database?sslmode=require

# ==========================================
# Server & Authentication Configuration
# ==========================================
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here
BACKEND_PUBLIC_URL=http://localhost:5000

# ==========================================
# Primary Admin Credentials
# ==========================================
# Email used for super admin login to /admin/login
ADMIN_EMAIL=admin@sit.edu.la
# Secure password for super admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=SIT Super Admin

# ==========================================
# SeaweedFS / S3 Storage Configuration
# ==========================================
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=university-media
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=any
S3_SECRET_ACCESS_KEY=any
S3_PUBLIC_URL=http://localhost:8333/university-media

# ==========================================
# Resend Email Service Configuration
# ==========================================
# Resend API Key from https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=re_your_api_key_here

# Sender email address
# Testing/Development: 'SIT Admissions <onboarding@resend.dev>'
# Production with custom domain: 'SIT Admissions <admissions@sit.edu.la>'
RESEND_FROM_EMAIL=SIT Admissions <onboarding@resend.dev>

# Recipient email address for admin notifications (Admissions & Info inquiries)
ADMIN_NOTIFICATION_EMAIL=admissions@sit.edu.la